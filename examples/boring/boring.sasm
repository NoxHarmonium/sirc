; Reserved space for 256x32 bit exception vectors
.ORG 0x0000
.DQ @init

.ORG 0x0200

:init
MOVI    r1, #5
MOVI    r2, #3
MOVI    r3, #64

:loop
ADDR    r2, r1
; Remember that COMP has the same argument order as SUBR
CMPR    r3, r2
BRAN|>= @loop

NOOP

; Stop the simulator via DEBUG; preserve r1-r7 for result checks.
MOVI[N] ah, #0x000B
MOVI[N] al, #0x0007
MOVI[N] ll, #1
STOR (a), ll