; https://rosettacode.org/wiki/Sieve_of_Eratosthenes

.EQU $MAX_PRIME #1000

; Reserved space for 256x32 bit exception vectors
.ORG 0x0000
.DQ @main

.ORG 0x0200
:main

; File I/O segment
MOVI    ah, #0x00F0
; Array Start = 0x00F0_0000
MOVI    al, #0x0000

; Stack segment (other end of mapped file)
MOVI    sh, #0x00F0
; Stack top = 0x00F0_FFFF
MOVI    sl, #0xFFFF

MOVI    r7, #2
MOVI    r1, #2
MOVI    r2, #1

:1

STOR    (r1, a), r2
ADDI    r1, #2
CMPI    r1, $MAX_PRIME
BRAN|<= @1
MOVI    r1, #3
MOVI    r3, #1

:2

LOAD    r2, (r1, a)
CMPI    r2, #1
BRAN|== @4
; THIS NUMBER IS A PRIME!
; TODO: Log this somehow
STOR    -(s), r1
MOVR    r7, r1
MOVR    r2, r1

:3
STOR    (r2, a), r3
ADDR    r2, r1
CMPI    r2, $MAX_PRIME
BRAN|<= @3

:4
ADDI    r1, #2
CMPI    r1, $MAX_PRIME
BRAN|<= @2

:DONE

; Stop the simulator via DEBUG; r7 is scratch after the results are produced.
MOVI[N] ah, #0x000B
MOVI[N] al, #0x0007
MOVI[N] r7, #1
STOR (a), r7
